# Copy this file to .env.local and replace the values with your own.
# Never commit .env.local — it is gitignored.

# --- Database ---
# Local MongoDB (default port, no password):
#   mongodb://127.0.0.1:27017/community-events
# MongoDB Atlas (from your cluster's "Connect" dialog):
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/community-events
MONGODB_URI=your_mongodb_connection_string

# --- Auth ---
# Secret used to sign JWT session tokens. Use a long random string.
# Generate one with: openssl rand -base64 32   (or any password manager)
JWT_SECRET=your_jwt_signing_secret

# --- Admin account ---
# The single configured admin account. ADMIN_PASSWORD_HASH must be a bcrypt hash.
# Generate an escaped hash locally (never commit the plain password):
#   npm run hash:password -- "your-admin-password"
# IMPORTANT: bcrypt hashes contain "$", which Next.js env parsing would treat as
# variable references. The hash:password script escapes each "$" as "\$" — copy
# the escaped output it prints directly into this file. Do not unescape it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash
